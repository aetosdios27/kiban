{
  "specs": [
    "Rust 2024",
    "no runtime dependencies by default",
    "Linux",
    "MIT"
  ],
  "guarantees": {
    "promised": [
      {
        "key": "sync()",
        "clause": "every write accepted before it survives a crash",
        "detail": "Successful sync() makes all previously accepted writes in every live WAL generation survive a crash, provided the OS, filesystem and device honor their persistence contract.",
        "evidence": [
          "seeded_crash_fixed_corpus",
          "shared_seeded_crash_fixed_corpus",
          "power_loss_recovers_exactly_the_last_synced_state_across_the_flush_pipeline"
        ]
      },
      {
        "key": "write(batch)",
        "clause": "all or nothing, one WAL record",
        "detail": "A write batch publishes and recovers all its mutations together, without exposing a partial batch.",
        "evidence": [
          "atomic_batch_never_exposes_a_prefix_to_gate_free_reads",
          "malformed_batch_never_applies_a_prefix",
          "torn_tail_inside_batch_drops_the_whole_batch"
        ]
      },
      {
        "key": "snapshot()",
        "clause": "unmoved by later writes and compactions",
        "detail": "A captured snapshot keeps its logical view across later writes, flushes and compactions.",
        "evidence": [
          "snapshot_captures_unflushed_versions_across_rotation_flush_and_compaction",
          "streaming_snapshot_range_and_backup_match_captured_state"
        ]
      },
      {
        "key": "a failed sync",
        "clause": "the engine refuses writes until reopened",
        "detail": "A failed WAL sync poisons the engine and blocks further mutations until a successful reopen of valid on-disk state.",
        "evidence": [
          "wal_sync_failure_poisons_and_blocks_all_mutations",
          "poisoned_runtime_state_clears_on_reopen_when_disk_is_valid"
        ]
      },
      {
        "key": "WAL, SST, MANIFEST",
        "clause": "CRC-32 checksummed",
        "detail": "WAL records, SST blocks and new versioned MANIFEST envelopes use CRC-32 checksums; legacy unversioned MANIFESTs upgrade on their next install.",
        "evidence": [
          "corrupted_record_is_reported_not_truncated",
          "any_single_byte_corruption_is_detected_on_parse_or_read",
          "checksummed_manifest_rejects_every_single_bit_flip",
          "legacy_manifest_and_new_envelope_roundtrip"
        ]
      },
      {
        "key": "after a crash",
        "clause": "a real past state, every synced write in it",
        "detail": "Under the simulated device model, recovered state equals some prefix of acknowledged writes that includes every successfully synced write.",
        "evidence": [
          "seeded_crash_fixed_corpus",
          "shared_seeded_crash_fixed_corpus"
        ]
      },
      {
        "key": "synced WAL damage",
        "clause": "reported when a later sync mark proves it",
        "detail": "Recovery reports corruption without modifying the WAL when a surviving later sync marker with the readable header's private nonce proves damaged bytes were synced; without that proof damage truncates, and deliberate nonce forgery is outside the threat model.",
        "evidence": [
          "damaged_records_need_a_later_sync_marker_to_be_corruption",
          "unreadable_header_disables_matching_marker_proof",
          "embedded_marker_with_different_nonce_in_torn_unsynced_value_truncates"
        ]
      },
      {
        "key": "WAL rotation",
        "clause": "old log synced before the next opens",
        "detail": "Rotation syncs the closed WAL generation before creating the next, so generations become durable in order.",
        "evidence": [
          "shared_frozen_wal_prefix_repro",
          "rotation_sync_failures_poison_before_creating_the_next_wal"
        ]
      }
    ],
    "not_promised": [
      {
        "key": "put() before sync()",
        "clause": "lost if the machine goes down",
        "detail": "A successful put() or delete() before sync() may be lost after a crash.",
        "evidence": [
          "seeded_crash_fixed_corpus",
          "shared_seeded_crash_fixed_corpus"
        ]
      },
      {
        "key": "drop",
        "clause": "not a sync",
        "detail": "Dropping a handle does not acknowledge crash durability.",
        "evidence": [
          "seeded_crash_fixed_corpus",
          "shared_seeded_crash_fixed_corpus"
        ]
      },
      {
        "key": "two processes, one directory",
        "clause": "not validated",
        "detail": "Concurrent access by two independent processes to one directory is not validated as a supported usage; the OS lock rejects a second owner.",
        "evidence": [
          "offline_cli_rejects_another_process_owner_and_restores_backups"
        ]
      },
      {
        "key": "machine power loss",
        "clause": "simulated, not tested on hardware",
        "detail": "Power loss is simulated with torn writes, directory durability and per-file loss; these suites do not establish behavior on physical hardware.",
        "evidence": [
          "seeded_power_loss_is_deterministic_and_covers_every_tear",
          "create_without_directory_sync_is_lost",
          "directory_sync_makes_entries_durable_but_not_unsynced_bytes",
          "rename_and_remove_revert_without_directory_sync"
        ]
      },
      {
        "key": "API, on-disk format",
        "clause": "may change before 1.0",
        "detail": "The API and storage format may change before 1.0."
      }
    ],
    "not_built": [
      {
        "key": "not built yet",
        "clause": "compression, range deletes, reverse iteration, transactions"
      }
    ]
  },
