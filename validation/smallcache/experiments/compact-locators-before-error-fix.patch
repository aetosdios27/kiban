+/// Derived, resident metadata only. Values remain in the immutable SST. Both
+/// paths check a value CRC on every read; these CRCs are derived only after
+/// checking the original block CRC and exact agreement with the point section.
+pub(super) struct PointLocators {
+    seed: u64,
+    pilots: Box<[u32]>,
+    slots: Box<[u64]>,
+    records: Box<[u8]>,
+    _reservation: ResidentReservation,
+}
+
+const LOCATOR_RESTART: usize = 16;
+const LOCATOR_ADDRESS_MASK: u64 = (1 << 48) - 1;
+
+fn put_varint(out: &mut Vec<u8>, mut n: u64) {
+    while n >= 128 {
+        out.push(n as u8 | 128);
+        n >>= 7;
+    }
+    out.push(n as u8);
+}
+
+// Only used on the private encoding produced below from validated input.
+fn take_varint(raw: &[u8], pos: &mut usize) -> u64 {
+    let mut n = 0;
+    let mut shift = 0;
+    loop {
+        let byte = raw[*pos];
+        *pos += 1;
+        n |= u64::from(byte & 127) << shift;
+        if byte < 128 {
+            return n;
+        }
+        shift += 7;
+    }
+}
+
+#[derive(Default)]
+struct LocatorBuilder {
+    records: Vec<u8>,
+    key: Vec<u8>,
+    previous: Vec<u8>,
+    versions: Vec<u8>,
+    version_count: u64,
+    keys: usize,
+    restart: usize,
+}
+
+impl LocatorBuilder {
+    fn finish_key(&mut self, section: &PointSection, slots: &mut [u64]) -> Result<(), SstError> {
+        if self.version_count == 0 {
+            return Ok(());
+        }
+        let ordinal = self.keys % LOCATOR_RESTART;
+        let shared = if ordinal == 0 {
+            self.restart = self.records.len();
+            0
+        } else {
+            super::common_prefix_len(&self.previous, &self.key)
+        };
+        let address = (self.restart as u64)
+            .checked_mul(LOCATOR_RESTART as u64)
+            .and_then(|n| n.checked_add(ordinal as u64))
+            .filter(|n| *n <= LOCATOR_ADDRESS_MASK)
+            .ok_or_else(|| bad("compact locator address overflow"))?;
+        let h = hash(&self.key, section.seed);
+        let slot = (section.slot(h) - HEADER - section.buckets * 4) / SLOT;
+        slots[slot] = address | (u64::from(fingerprint(h)) << 48);
+        put_varint(&mut self.records, shared as u64);
+        put_varint(&mut self.records, (self.key.len() - shared) as u64);
+        self.records.extend_from_slice(&self.key[shared..]);
+        let mut count = Vec::new();
+        put_varint(&mut count, self.version_count);
+        put_varint(
+            &mut self.records,
+            (count.len() + self.versions.len()) as u64,
+        );
+        self.records.extend_from_slice(&count);
+        self.records.extend_from_slice(&self.versions);
+        self.previous.clone_from(&self.key);
+        self.versions.clear();
+        self.version_count = 0;
+        self.keys += 1;
         Ok(())
     }
+}
 
