+impl PointLocators {
+    pub(super) fn decode(
+        bytes: crate::cache::ArcBlock,
+        data_len: usize,
+        cache: &std::sync::Arc<crate::cache::BlockCache>,
+        blocks: impl IntoIterator<Item = (u64, u64)>,
+        mut read: impl FnMut(u64, u64) -> Result<Vec<u8>, SstError>,
+    ) -> Result<Option<Self>, SstError> {
+        let section = PointSection::decode(bytes, data_len)?;
+        // The private encoding can be larger than its source for unusual keys.
+        let fixed = section.count * 8 + section.buckets * 4;
+        if fixed > cache.capacity() {
+            return Ok(None);
+        }
+        let mut slots = vec![0; section.count];
+        let mut builder = LocatorBuilder::default();
+        let mut denied = false;
+        section.visit_backing(
+            data_len,
+            blocks,
+            |offset, len| read(offset, len).map(std::borrow::Cow::Owned),
+            |kind, seq, key, offset, value| {
+                if denied {
+                    return Ok(());
+                }
+                if builder
+                    .records
+                    .len()
+                    .saturating_add(builder.versions.len())
+                    .saturating_add(fixed)
+                    > cache.capacity()
+                {
+                    denied = true;
+                    return Ok(());
+                }
+                if builder.version_count != 0 && builder.key != key {
+                    builder.finish_key(&section, &mut slots)?;
+                }
+                if builder.version_count == 0 {
+                    builder.key.clear();
+                    builder.key.extend_from_slice(key);
+                }
+                put_varint(&mut builder.versions, seq);
+                builder.versions.push(kind.to_u8());
+                put_varint(&mut builder.versions, value.len() as u64);
+                put_varint(&mut builder.versions, offset as u64);
+                builder
+                    .versions
+                    .extend_from_slice(&crate::crc32::crc32(value).to_le_bytes());
+                builder.version_count += 1;
+                Ok(())
+            },
+        )?;
+        if denied {
+            return Ok(None);
+        }
+        builder.finish_key(&section, &mut slots)?;
+        let resident = fixed
+            .checked_add(builder.records.len())
+            .ok_or_else(|| bad("locator size overflow"))?;
+        let Some(reservation) = cache.reserve_point(resident) else {
+            return Ok(None);
+        };
+        let pilots = (0..section.buckets)
+            .map(|b| u32_at(&section.bytes, HEADER + b * 4))
+            .collect();
+        Ok(Some(Self {
+            seed: section.seed,
+            pilots,
+            slots: slots.into_boxed_slice(),
+            records: builder.records.into_boxed_slice(),
+            _reservation: reservation,
+        }))
+    }
+
+    pub(super) fn get(&self, target: &[u8], limit: Option<u64>) -> Option<ValueLocator> {
+        let h = hash(target, self.seed);
+        let slot = self.slots[index(h, &self.pilots, self.slots.len())];
+        if (slot >> 48) as u16 != fingerprint(h) {
+            return None;
+        }
+        let address = slot & LOCATOR_ADDRESS_MASK;
+        let mut pos = (address / LOCATOR_RESTART as u64) as usize;
+        let mut key = Vec::new();
+        for ordinal in 0..=address as usize % LOCATOR_RESTART {
+            let shared = take_varint(&self.records, &mut pos) as usize;
+            let suffix = take_varint(&self.records, &mut pos) as usize;
+            key.truncate(shared);
+            key.extend_from_slice(&self.records[pos..pos + suffix]);
+            pos += suffix;
+            let len = take_varint(&self.records, &mut pos) as usize;
+            if ordinal != address as usize % LOCATOR_RESTART {
+                pos += len;
+            }
+        }
+        // Fingerprints never substitute for a full byte-key comparison.
+        if key != target {
+            return None;
+        }
+        let count = take_varint(&self.records, &mut pos);
+        for _ in 0..count {
+            let seq = take_varint(&self.records, &mut pos);
+            let kind = Kind::from_u8(self.records[pos]).expect("validated kind");
+            pos += 1;
+            let len = take_varint(&self.records, &mut pos) as usize;
+            let offset = take_varint(&self.records, &mut pos);
+            let checksum = u32_at(&self.records, pos);
+            pos += 4;
+            if limit.is_none_or(|lim| seq <= lim) {
+                return Some(ValueLocator {
+                    kind,
+                    seq,
+                    offset,
+                    len,
+                    checksum,
+                });
+            }
+        }
+        None
+    }
+}
