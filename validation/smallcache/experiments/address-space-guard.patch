+// A file may exceed usize on a 32-bit reader even when its locator metadata
+// fits the cache. Preserve the positional sorted fallback for those tables.
+#[inline(always)]
+fn compact_admission(count: u64, buckets: u64, data_end: u64, capacity: usize) -> bool {
+    usize::try_from(data_end).is_ok() && count * 8 + buckets * 4 <= capacity as u64
+}
