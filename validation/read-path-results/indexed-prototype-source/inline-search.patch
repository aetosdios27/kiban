+            Some(PointIndex::Ready(index)) => Ok(read(&entry.block, Some(index))),
+            Some(PointIndex::Corrupt(error)) => Err(error.clone()),
+            Some(PointIndex::Unavailable) | None => Ok(read(&entry.block, None)),
+        })
+    }
