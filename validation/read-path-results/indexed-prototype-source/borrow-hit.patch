+    /// Borrows a resident block for a bounded point lookup. The callback must
+    /// not reenter this cache: membership remains read-locked until it returns.
+    /// Large blocks return owned storage for decoding after the guard drops.
+    pub(crate) fn with_point<R>(
+        &self,
+        key: &CacheKey,
+        read: impl FnOnce(&CachedBlock) -> R,
+    ) -> Option<Result<R, CachedBlock>> {
+        let inner = self.inner.read().expect("block cache lock poisoned");
+        let Some(entry) = inner.map.get(key) else {
+            self.misses.increment();
+            return None;
+        };
+        if !entry.referenced.load(Ordering::Relaxed) {
+            entry.referenced.store(true, Ordering::Relaxed);
+        }
+        self.hits.increment();
+        // Large values/keys must not extend the membership lock's lifetime.
+        if entry.block.data.len() > 16 * 1024 {
+            return Some(Err(entry.block.clone()));
+        }
+        Some(Ok(read(&entry.block)))
+    }
