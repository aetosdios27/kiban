+    #[test]
+    fn prefix_comparison_preserves_binary_keys_history_and_tombstones() {
+        let keys = [
+            vec![],
+            vec![0],
+            vec![0, 0],
+            vec![0, 255],
+            vec![1],
+            vec![1, 0],
+            vec![1, 0, 255],
+            vec![255; 80],
+            vec![255; 81],
+        ];
+        let mut builder = BlockBuilder::default();
+        let mut entries = Vec::new();
+        for key in &keys {
+            for seq in (1..=40u64).rev() {
+                let kind = if seq % 7 == 0 {
+                    Kind::Tombstone
+                } else {
+                    Kind::Put
+                };
+                let value = if kind == Kind::Put {
+                    seq.to_le_bytes().to_vec()
+                } else {
+                    Vec::new()
+                };
+                builder.add(kind, key, &value, seq);
+                entries.push((key.clone(), kind, seq, value));
+            }
+        }
+        let block = VerifiedBlock::from_raw(builder.finish()).unwrap();
+        for key in keys
+            .into_iter()
+            .chain([vec![0, 0, 0], vec![0, 1], vec![1, 0, 0], vec![255; 82]])
+        {
+            for limit in (0..=41).map(Some).chain([None]) {
+                let expected = entries
+                    .iter()
+                    .find(|entry| entry.0 == key && limit.is_none_or(|limit| entry.2 <= limit))
+                    .map(|entry| (entry.1, entry.2, entry.3.as_slice()));
+                let actual = block
+                    .get(&key, limit)
+                    .unwrap()
+                    .map(|entry| (entry.kind, entry.seq, entry.value));
+                assert_eq!(actual, expected, "key={key:?}, limit={limit:?}");
+            }
+        }
+    }
