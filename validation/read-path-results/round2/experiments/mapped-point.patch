+/// Search immutable bytes after their checksum and restart layout have been
+/// verified. A mapped caller borrows its table; owned blocks use the same decoder.
+pub(crate) fn get_verified<'a>(
+    data: &'a [u8],
+    meta: &BlockMeta,
+    target: &[u8],
+    limit: Option<u64>,
+) -> Result<Option<Match<'a>>, SstError> {
+    let start = seek_restart_index(data, meta, target)?;
+    let mut key: Vec<u8> = Vec::new();
+    let mut pos = restart_offset_of(data, meta.restart_start, start);
+
+    loop {
+        if pos >= meta.entries_end {
+            return Ok(None);
+        }
+        let (kind, seq, shared, non_shared, value_len) = header_at(data, meta, pos)?;
+        if shared > key.len() {
+            return Err(SstError::Corrupt(
+                "shared length exceeds previous key".to_string(),
+            ));
+        }
+        key.truncate(shared);
+        key.extend_from_slice(&data[pos + ENTRY_FIXED_LEN..pos + ENTRY_FIXED_LEN + non_shared]);
+        let value = entry_value(data, pos, kind, non_shared, value_len);
+        if key.as_slice() == target {
+            // visibility limit: skip versions newer than the snapshot
+            // bound; entries for one key are seq-descending, so the
+            // first qualifying match is the newest visible version
+            if limit.is_none_or(|lim| seq <= lim) {
+                return Ok(Some(Match { kind, seq, value }));
+            }
+        }
+        if key.as_slice() > target {
+            return Ok(None);
+        }
+        pos += ENTRY_FIXED_LEN + non_shared + value_len;
+    }
+}
