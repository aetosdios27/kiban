+    /// Slots avoid hashing and entry indirection on a point hit. Mutation
+    /// always locks the cache before a slot; the hit path releases the slot
+    /// read guard before it can enter the cache's miss path.
+    pub(crate) fn get_or_load_with_handle<E, F>(
+        &self,
+        key: CacheKey,
+        handle: &Arc<BlockHandle>,
+        load: F,
+    ) -> Result<CachedBlock, String>
+    where
+        F: FnOnce() -> Result<CachedBlock, E>,
+        E: std::fmt::Display,
+    {
+        let hit = handle
+            .block
+            .read()
+            .expect("block handle lock poisoned")
+            .clone();
+        if let Some(block) = hit {
+            handle.referenced.store(true, Ordering::Relaxed);
+            self.hits.increment();
+            return Ok(block);
+        }
+        let block = self.get_or_load(key, load)?;
+        let mut resident = self.inner.write().expect("block cache lock poisoned");
+        if let Some(entry) = resident.map.get_mut(&key) {
+            // A trivial move can reopen a table with another set of slots.
+            // Keep at most one bound slot per resident and invalidate the old
+            // one while admission/eviction is excluded by the cache lock.
+            if let Some(old) = entry.handle.replace(handle.clone())
+                && !Arc::ptr_eq(&old, handle)
+            {
+                old.block
+                    .write()
+                    .expect("block handle lock poisoned")
+                    .take();
+            }
+            *handle.block.write().expect("block handle lock poisoned") = Some(entry.block.clone());
+        }
+        Ok(block)
+    }
