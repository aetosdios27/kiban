+    #[test]
+    fn point_handles_do_not_keep_evicted_or_bypassed_blocks_alive() {
+        let cache = BlockCache::new(100);
+        let handle = Arc::new(BlockHandle::default());
+        let data = cache
+            .get_or_load_with_handle((1, 0), &handle, || Ok::<_, String>(block(100, 7)))
+            .unwrap();
+        let weak_data = Arc::downgrade(&data.data);
+        drop(data);
+        cache.insert((2, 0), block(100, 9));
+        assert!(handle.block.read().unwrap().is_none());
+        assert!(weak_data.upgrade().is_none());
+        assert_eq!(cache.resident_bytes(), 100);
+        let data = cache
+            .get_or_load_with_handle((1, 0), &handle, || Ok::<_, String>(block(200, 3)))
+            .unwrap();
+        assert_eq!(data.data.as_ref(), &[3; 200]);
+        assert!(handle.block.read().unwrap().is_none());
+        assert_eq!(cache.resident_bytes(), 100);
+        assert!(
+            cache
+                .get_or_load_with_handle((1, 0), &handle, || Err::<CachedBlock, _>("bad checksum"))
+                .is_err()
+        );
+        assert!(handle.block.read().unwrap().is_none());
+    }
+
+    #[test]
+    fn point_handle_rebinding_invalidates_the_previous_slot() {
+        let cache = BlockCache::new(100);
+        let first = Arc::new(BlockHandle::default());
+        let second = Arc::new(BlockHandle::default());
+        for handle in [&first, &second] {
+            let block = cache
+                .get_or_load_with_handle((1, 0), handle, || Ok::<_, String>(block(100, 7)))
+                .unwrap();
+            assert_eq!(block.data.as_ref(), &[7; 100]);
+        }
+        assert!(first.block.read().unwrap().is_none());
+        assert!(second.block.read().unwrap().is_some());
+        cache.insert((2, 0), block(100, 9));
+        assert!(second.block.read().unwrap().is_none());
+        assert_eq!(cache.resident_bytes(), 100);
+    }
+
+    #[test]
+    fn point_handles_race_eviction_without_stale_values_or_budget_growth() {
+        let cache = Arc::new(BlockCache::new(4 * 256));
+        let handles: Arc<Vec<_>> =
+            Arc::new((0..64).map(|_| Arc::new(BlockHandle::default())).collect());
+        let barrier = Arc::new(Barrier::new(8));
+        let threads: Vec<_> = (0..8)
+            .map(|thread| {
+                let cache = cache.clone();
+                let handles = handles.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    barrier.wait();
+                    for i in 0..20_000 {
+                        let index = (i * 17 + thread * 7) % handles.len();
+                        let found = cache
+                            .get_or_load_with_handle((1, index as u64), &handles[index], || {
+                                Ok::<_, String>(block(256, index as u8))
+                            })
+                            .unwrap();
+                        assert_eq!(found.data.as_ref(), &[index as u8; 256]);
+                        assert!(cache.resident_bytes() <= cache.capacity());
+                        if i % 101 == 0 {
+                            std::thread::yield_now();
+                        }
+                    }
+                })
+            })
+            .collect();
+        for thread in threads {
+            thread.join().unwrap();
+        }
+        assert!(cache.stats().evictions > 1000);
+        assert_eq!(cache.in_flight_len(), 0);
+        assert_eq!(cache.resident_entries(), cache.clock_entries());
+        // One insertion can evict all remaining handled entries. There are
+        // no reader-owned residents after joining the threads.
+        cache.insert((2, 0), block(cache.capacity(), 0));
+        assert!(
+            handles
+                .iter()
+                .all(|slot| slot.block.read().unwrap().is_none())
+        );
+    }
