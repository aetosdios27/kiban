+    /// Point reads address the known block directly. The map still owns
+    /// admission, byte accounting and CLOCK policy. No raw pointer or
+    /// publication epoch is needed: the weak upgrade pins an immutable
+    /// entry only long enough to clone its block, just as a map hit does.
+    pub(crate) fn get_or_load_with_handle<E, F>(
+        &self,
+        key: CacheKey,
+        handle: &BlockHandle,
+        load: F,
+    ) -> Result<CachedBlock, String>
+    where
+        F: FnOnce() -> Result<CachedBlock, E>,
+        E: std::fmt::Display,
+    {
+        if let Some(entry) = handle
+            .0
+            .read()
+            .expect("block handle lock poisoned")
+            .upgrade()
+        {
+            entry.referenced.store(true, Ordering::Relaxed);
+            self.hits.increment();
+            return Ok(entry.block.clone());
+        }
+        let block = self.get_or_load(key, load)?;
+        // Eviction may win between load and bind; in that case leave an
+        // empty slot. Bind the current resident, never the returned clone.
+        let resident = self.inner.read().expect("block cache lock poisoned");
+        *handle.0.write().expect("block handle lock poisoned") = resident
+            .map
+            .get(&key)
+            .map_or_else(Weak::new, Arc::downgrade);
+        Ok(block)
+    }
