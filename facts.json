  "examples": {
    "basic": "use kiban::db::Kiban;\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    let mut db = Kiban::open(\"example-db\")?;\n    db.put(b\"hello\", b\"world\")?;\n    db.sync()?; // put alone is not crash-durable\n    assert_eq!(db.get(b\"hello\")?, Some(b\"world\".to_vec()));\n    drop(db);\n\n    let reopened = Kiban::open(\"example-db\")?;\n    assert_eq!(reopened.get(b\"hello\")?, Some(b\"world\".to_vec()));\n    Ok(())\n}\n",
    "batch": "use kiban::db::{Kiban, WriteBatch};\n\nlet mut db = Kiban::open(directory)?;\nlet mut batch = WriteBatch::new();\nbatch.put(b\"hello\".to_vec(), b\"world\".to_vec());\nbatch.put(b\"goodbye\".to_vec(), b\"moon\".to_vec());\nbatch.delete(b\"obsolete\".to_vec());\ndb.write(batch)?;\ndb.sync()?;\nassert_eq!(db.get(b\"hello\")?, Some(b\"world\".to_vec()));\nassert_eq!(db.get(b\"goodbye\")?, Some(b\"moon\".to_vec()));\nassert_eq!(db.get(b\"obsolete\")?, None);\n",
    "python": "from kiban import Kiban\n\nwith Kiban(directory) as db:\n    db.put(\"hello\", \"world\")\n    db.sync()\n    assert db.get(\"hello\") == b\"world\"\n    with db.snapshot() as snapshot:\n        db.put(\"hello\", \"later\")\n        assert snapshot.get(\"hello\") == b\"world\"\n    db.batch([(\"put\", \"a\", \"1\"), (\"put\", \"b\", \"2\")])\n    assert list(db.scan(\"a\", \"c\")) == [(b\"a\", b\"1\"), (b\"b\", b\"2\")]\n",
    "range": "use kiban::db::Kiban;\n\nlet mut db = Kiban::open(directory)?;\ndb.put(b\"a\", b\"1\")?;\ndb.put(b\"b\", b\"2\")?;\ndb.put(b\"c\", b\"3\")?;\n// Byte-wise ascending order, start included and end excluded.\nlet entries = db.range(b\"a\", b\"c\").collect::<Result<Vec<_>, _>>()?;\nassert_eq!(\n    entries,\n    vec![\n        (b\"a\".to_vec(), b\"1\".to_vec()),\n        (b\"b\".to_vec(), b\"2\".to_vec())\n    ]\n);\n",
    "shared": "use kiban::db::SharedKiban;\n\nlet db = SharedKiban::open(directory)?;\ndb.put(b\"greeting\", b\"before\")?;\nlet snapshot = db.snapshot()?;\nlet writer = db.clone();\nstd::thread::spawn(move || writer.put(b\"greeting\", b\"after\"))\n    .join()\n    .expect(\"writer panicked\")?;\nassert_eq!(snapshot.get(b\"greeting\")?, Some(b\"before\".to_vec()));\nassert_eq!(db.get(b\"greeting\")?, Some(b\"after\".to_vec()));\nfor entry in snapshot.iter() {\n    let (key, value) = entry?;\n    println!(\n        \"{} = {}\",\n        String::from_utf8_lossy(&key),\n        String::from_utf8_lossy(&value)\n    );\n}\ndrop(snapshot);\ndb.close()?;\n",
    "snapshot": "use kiban::db::Kiban;\n\nlet mut db = Kiban::open(directory)?;\ndb.put(b\"hello\", b\"before\")?;\nlet snapshot = db.snapshot();\ndb.put(b\"hello\", b\"after\")?;\nassert_eq!(db.get_at(&snapshot, b\"hello\")?, Some(b\"before\".to_vec()));\nassert_eq!(db.get(b\"hello\")?, Some(b\"after\".to_vec()));\n"
  },
